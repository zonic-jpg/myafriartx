# ── MyAfriArt / ArtStage — environment ──────────────────────────────────────
# Vite injects VITE_* at BUILD time (browser). The Node server (server.mjs)
# loads this whole file at RUNTIME for the server-side vars below.
# On AWS you can instead set these in the service/task environment (those win).

# Browser (build time) — Supabase anon/publishable
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Google OAuth UI — leave unset/false unless Supabase has Google provider secret
VITE_GOOGLE_AUTH=false

# Server (runtime) — auth middleware + SSR
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Server (runtime) — REQUIRED for "Save Preferences", "Send sample reel",
# "Stage the Room". These were MISSING and are why those actions failed:
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY   # Supabase dashboard → Project Settings → API
AI_API_KEY=YOUR_AI_IMAGE_GATEWAY_KEY                       # room stager + content intake + letter contact lookup (server-side)
# Optional AI overrides (defaults shown):
# AI_API_URL=https://ai.gateway.lovable.dev/v1
# AI_IMAGE_MODEL=google/gemini-3-pro-image-preview
RESEND_API_KEY=YOUR_RESEND_API_KEY                         # Letter Studio send (verified sender required)
LETTERS_FROM=MyAfriArt <partnerships@myafriart.com>        # Resend from address

# /api/admin-bridge — approvals queue, submission moderation, letter send.
# Privileged actions require a valid Supabase JWT (owner/admin) or the orbit gate
# password verified server-side. Email headers alone are never accepted.
# Dev-only: unlocks local admin gate in non-production builds (never set in Netlify prod)
# VITE_DEV_ADMIN_PASSWORD=your_local_dev_password
PAYSTACK_SECRET_KEY=your_paystack_secret
PUBLIC_APP_URL=https://your-domain.com
CRON_SECRET=generate_a_long_random_secret_for_auction_cron
